{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "test:coverage": "c8 node --import tsx --import ./test/setup.ts --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "c8": "^10.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
